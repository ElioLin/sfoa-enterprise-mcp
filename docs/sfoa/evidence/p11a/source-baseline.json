    {
      "path": "packages/mcp",
      "manifest": {
        "name": "@salesforce/mcp",
        "version": "0.30.15",
        "description": "MCP Server for interacting with Salesforce instances",
        "bin": {
          "sf-mcp-server": "bin/run.js"
        },
        "types": "lib/index.d.ts",
        "license": "Apache-2.0",
        "type": "module",
        "scripts": {
          "build": "wireit",
          "build:watch": "yarn build --watch",
          "clean": "tsc --build --clean",
          "clean-all": "yarn clean && rimraf node_modules",
          "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
          "format": "wireit",
          "link-check": "wireit",
          "lint": "wireit",
          "test": "wireit",
          "test:only": "wireit"
        },
        "repository": "salesforcecli/mcp",
        "bugs": {
          "url": "https://github.com/salesforcecli/mcp/issues"
        },
        "homepage": "https://github.com/salesforcecli/mcp",
        "files": [
          "bin",
          "lib",
          "!lib/**/*.map",
          "messages",
          "LICENSE.txt",
          "npm-shrinkwrap.json",
          "package.json"
        ],
        "engines": {
          "node": ">=20.0.0"
        },
        "dependencies": {
          "@modelcontextprotocol/sdk": "^1.18.0",
          "@oclif/core": "^4.5.1",
          "@salesforce/agents": "^0.25.1",
          "@salesforce/apex-node": "^8.2.1",
          "@salesforce/core": "^8.29.0",
          "@salesforce/kit": "^3.1.6",
          "@salesforce/mcp-provider-api": "0.6.0",
          "@salesforce/mcp-provider-dx-core": "0.9.8",
          "@salesforce/mcp-provider-code-analyzer": "0.8.1",
          "@salesforce/mcp-provider-lwc-experts": "0.7.0",
          "@salesforce/mcp-provider-aura-experts": "0.3.7",
          "@salesforce/mcp-provider-mobile-web": "0.3.0",
          "@salesforce/mcp-provider-devops": "0.3.8",
          "@salesforce/mcp-provider-scale-products": "0.0.6",
          "@salesforce/mcp-provider-metadata-enrichment": "0.1.8",
          "@salesforce/source-deploy-retrieve": "^12.35.0",
          "@salesforce/source-tracking": "^7.8.14",
          "@salesforce/telemetry": "^6.8.19",
          "@salesforce/ts-types": "^2.0.12",
          "zod": "^3.25.76"
        },
        "devDependencies": {
          "@salesforce/cli-plugins-testkit": "^5.3.39",
          "@salesforce/dev-config": "^4.3.2",
          "prettier": "^2.8.8",
          "@types/node": "^22.16.5",
          "wireit": "^0.14.12",
          "eslint": "^8.57.1",
          "mocha": "11.7.5",
          "chai": "^4.3.10",
          "@types/mocha": "^10.0.10",
          "@types/chai": "^4.3.14",
          "@types/sinon": "^10.0.20",
          "sinon": "10.0.0",
          "nyc": "^17.0.0",
          "eslint-config-salesforce-license": "^1.0.1",
          "eslint-config-salesforce-typescript": "4.0.1",
          "@salesforce/prettier-config": "^0.0.3",
          "oclif": "^4.21.0",
          "ts-node": "^10.9.2",
          "typescript": "^5.8.3"
        },
        "overrides": {
          "nock": "^13.5.6"
        },
        "publishConfig": {
          "access": "public"
        },
        "oclif": {
          "bin": "sf-mcp-server",
          "dirname": "sf-mcp-server",
          "commands": {
            "strategy": "single",
            "target": "./lib/index.js"
          }
        },
        "wireit": {
          "build": {
            "command": "tsc --build --pretty --incremental --verbose",
            "files": [
              "src/**/*.ts",
              "**/tsconfig.json"
            ],
            "output": [
              "lib/**",
              "*.tsbuildinfo"
            ],
            "clean": "if-file-deleted"
          },
          "format": {
            "command": "prettier --write \"+(src|test)/**/*.+(ts|js|json)\"",
            "files": [
              "src/**/*.ts",
              "test/**/*.ts",
              ".prettier*"
            ],
            "output": []
          },
          "lint": {
            "command": "eslint src test --color --cache --cache-location .eslintcache",
            "files": [
              "src/**/*.ts",
              "test/**/*.ts",
              "**/.eslint*",
              "**/tsconfig.json"
            ],
            "output": []
          },
          "test:compile": {
            "command": "tsc -p \"./test\" --pretty",
            "files": [
              "test/**/*.ts",
              "**/tsconfig.json"
            ],
            "output": []
          },
          "test": {
            "command": "nyc mocha \"test/**/*.test.ts\"",
            "env": {
              "FORCE_COLOR": "2"
            },
            "files": [
              "test/**/*.ts",
              "src/**/*.ts",
              "**/tsconfig.json",
              ".mocha*",
              ".nycrc"
            ],
            "dependencies": [
              "test:compile",
              "lint"
            ],
            "output": []
          }
        }
      }
    },
