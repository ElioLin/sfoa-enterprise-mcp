{
  "name": "monorepo-for-salesforce-mcp-server-and-providers",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "**"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@modelcontextprotocol/inspector": "^0.15.0",
    "rimraf": "^6.0.1"
  },
  "overrides": {
    "@salesforce/core": "^8.29.0",
    "nock": "^13.5.6"
  },
  "scripts": {
    "agent:sync": "yarn workspace @sfoa/agent-playbook run sync",
    "agent:check": "yarn workspace @sfoa/agent-playbook run check",
    "review:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-review.ps1",
    "build": "yarn workspaces run build",
    "clean": "yarn workspaces run clean",
    "clean-all": "yarn workspaces run clean-all && rimraf node_modules",
    "lint": "yarn workspaces run lint",
    "package": "yarn workspaces run package",
    "test": "yarn workspaces run test",
    "db:create": "yarn workspace @sfoa/control-plane db:create",
    "db:migrate": "yarn workspace @sfoa/control-plane db:migrate",
    "db:status": "yarn workspace @sfoa/control-plane db:status",
    "p5:bootstrap": "yarn workspace @sfoa/control-plane p5:bootstrap",
    "admin:api:dev": "yarn workspace @sfoa/admin-api dev",
    "admin:web:dev": "yarn workspace @sfoa/admin-web dev",
    "p5:dev": "node scripts/p5-dev.mjs",
    "dev:sfoa": "node scripts/p5-dev.mjs",
    "p5:test": "yarn workspace @sfoa/control-plane test && yarn workspace @sfoa/control-plane test:mysql && yarn workspace @sfoa/identity-runtime test && yarn workspace @sfoa/mcp-server test:p5 && yarn workspace @sfoa/admin-api test && yarn workspace @sfoa/admin-web test",
    "p5:test:runtime:mysql": "yarn workspace @sfoa/mcp-server test:p5:mysql",
    "p5:e2e": "yarn workspace @sfoa/admin-web e2e",
    "p5:e2e:fullstack": "yarn workspace @sfoa/control-plane build && yarn workspace @sfoa/admin-api build && yarn workspace @sfoa/admin-web build && node scripts/p5-fullstack-e2e.mjs",
    "validate:p5": "node scripts/validate-p5.mjs"
  }
}
