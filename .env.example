# Copy to .env.local for local integration testing. Never commit real values.
SFOA_INSTANCE_URL=
# Optional trusted HTTPS origin used only by get_record_links; no runtime default or Connection fallback.
SFOA_LIGHTNING_BASE_URL=
SALESFORCE_USERNAME=
# P4: fixed server-owned Integration User; must differ from every USER Salesforce username.
# Required only when a diagnostic Tool is enabled.
SFOA_DIAGNOSTIC_USERNAME=
CONNECTED_APP_CLIENT_ID=
JWT_PRIVATE_KEY_PATH=
SALESFORCE_ALIAS=
TEST_OBJECT=
TEST_METADATA_TYPE=
TEST_METADATA_FULL_NAME=
SFOA_DEBUG_EXPOSE_TOKEN=false
SECOND_TEST_USER=
P1_PLATFORM_USER_A=
P1_PLATFORM_USER_B=

# P5 Control Plane. env preserves P0-P4 compatibility; mysql is authoritative and fail-closed.
SFOA_CONTROL_PLANE_MODE=
SFOA_DB_HOST=
SFOA_DB_PORT=
SFOA_DB_NAME=
SFOA_DB_USER=
SFOA_DB_PASSWORD=
SFOA_DB_SSL_MODE=
SFOA_DB_CONNECTION_LIMIT=
SFOA_DB_QUEUE_LIMIT=
SFOA_DB_CONNECT_TIMEOUT_MS=

# P5 Admin API. SFOA_ADMIN_PASSWORD is the plaintext Admin login password (local development).
# Set a real value only in .env.local; never commit it. Do not use a password hash here.
# SFOA_ADMIN_SESSION_SECRET must be an independent random value of at least 32 characters.
SFOA_ADMIN_BIND_HOST=
SFOA_ADMIN_PORT=
SFOA_ADMIN_ALLOWED_ORIGIN=
SFOA_ADMIN_USERNAME=
SFOA_ADMIN_PASSWORD=
SFOA_ADMIN_SESSION_SECRET=
SFOA_ADMIN_SESSION_TTL_SECONDS=
SFOA_ADMIN_COOKIE_SECURE=
SFOA_ADMIN_LOGIN_MAX_ATTEMPTS=
SFOA_ADMIN_LOGIN_WINDOW_MS=

# Runtime defaults (optional)
PORT=3000
LOG_LEVEL=info

# P2 remote MCP runtime (MCP_CLIENT_TOKEN is a secret; set its real value only in .env.local)
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8080
MCP_PATH=/mcp
# Admin/client configuration only; does not change the Runtime bind address.
MCP_PUBLIC_URL=
MCP_AUTH_MODE=internal_bearer
MCP_CLIENT_TOKEN=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MCP_IDENTITY_CREDENTIAL_ENCRYPTION_KEY=
MCP_PLATFORM_USER_HEADER=X-Platform-User-Id
MCP_MAX_BODY_BYTES=1048576
MCP_REQUEST_TIMEOUT_MS=180000
MCP_TOOL_TIMEOUT_MS=120000
MCP_ENABLED_TOOLS=get_username,run_soql_query,get_agent_playbook,get_record_links
# P3: optional strict JSON array. Missing/empty/[] denies all DML.
MCP_DML_ALLOWLIST_JSON=
# P3 live validator (Lead has safe defaults; configure fields for other objects).
P3_CREATE_FIELDS_JSON=
P3_UPDATE_FIELDS_JSON=
P3_VALIDATION_FAILURE_FIELDS_JSON=
# Optional native permission-denial gate; omit both to report NOT TESTED.
P3_PERMISSION_DENIAL_OBJECT=
P3_PERMISSION_DENIAL_FIELDS_JSON=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# P6-ID-02: Buntu (Xiaoben / Dify) real-user identity as a third credential source.
# Buntu bearer tokens are never interpreted locally; each request re-validates the
# raw token against MCP_BUNTU_VALIDATE_TOKEN_URL, which must answer the strict
# { "user_id": "<platformUserId>" } contract with HTTP 2xx. Fail-closed: no fallback.
# Requires MCP_AUTH_MODE=internal_bearer and SFOA_CONTROL_PLANE_MODE=mysql.
MCP_BUNTU_IDENTITY_ENABLED=false
# GET endpoint that validates a Buntu token. Required when ENABLED=true.
# Only "Accept: application/json" and "Authorization: Bearer <token>" are forwarded.
MCP_BUNTU_VALIDATE_TOKEN_URL=
# Validate timeout in milliseconds; clamped to 500..30000. Default 5000.
MCP_BUNTU_VALIDATE_TIMEOUT_MS=5000
# Compatibility key only. P7 permanently prohibits raw Bearer-token audit capture;
# setting this to true causes startup validation to fail.
MCP_BUNTU_AUDIT_RAW_TOKEN_ENABLED=false
