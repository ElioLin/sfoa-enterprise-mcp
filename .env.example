# Copy to .env.local for local integration testing. Never commit real values.
SFOA_INSTANCE_URL=
SALESFORCE_USERNAME=
# P4: fixed server-owned Integration User; must differ from every USER Salesforce username.
# Required only when a diagnostic Tool is enabled.
SFOA_DIAGNOSTIC_USERNAME=
CONNECTED_APP_CLIENT_ID=
JWT_PRIVATE_KEY_PATH=
SALESFORCE_ALIAS=
TEST_OBJECT=
TEST_METADATA_TYPE=
TEST_METADATA_FULL_NAME=
SFOA_DEBUG_EXPOSE_TOKEN=false
SECOND_TEST_USER=

# Runtime defaults (optional)
PORT=3000
LOG_LEVEL=info

# P2 remote MCP runtime (MCP_CLIENT_TOKEN is a secret; set its real value only in .env.local)
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8080
MCP_PATH=/mcp
MCP_AUTH_MODE=internal_bearer
MCP_CLIENT_TOKEN=
MCP_PLATFORM_USER_HEADER=X-Platform-User-Id
MCP_MAX_BODY_BYTES=1048576
MCP_REQUEST_TIMEOUT_MS=180000
MCP_TOOL_TIMEOUT_MS=120000
MCP_ENABLED_TOOLS=get_username,run_soql_query
# P3: optional strict JSON array. Missing/empty/[] denies all DML.
MCP_DML_ALLOWLIST_JSON=
# P3 live validator (Lead has safe defaults; configure fields for other objects).
P3_CREATE_FIELDS_JSON=
P3_UPDATE_FIELDS_JSON=
P3_VALIDATION_FAILURE_FIELDS_JSON=
# Optional native permission-denial gate; omit both to report NOT TESTED.
P3_PERMISSION_DENIAL_OBJECT=
P3_PERMISSION_DENIAL_FIELDS_JSON=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
