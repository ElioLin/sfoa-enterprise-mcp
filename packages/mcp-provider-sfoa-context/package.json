{
  "name": "@sfoa/mcp-provider-sfoa-context",
  "version": "0.1.0-p4",
  "private": true,
  "description": "P4 deterministic Salesforce diagnostic and record-action context Provider",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean-all": "yarn clean",
    "lint": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "package": "node -e \"console.log('Private P4 SFoA Context Provider: package skipped')\"",
    "test": "yarn build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.18.2",
    "@salesforce/core": "8.29.0",
    "@salesforce/mcp-provider-api": "0.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "typescript": "5.8.3"
  }
}
