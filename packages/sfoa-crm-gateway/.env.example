# SFoA CRM chat access service. Copy to .env.local (or the service environment).
# Never commit real values.

CRM_BIND_HOST=127.0.0.1
CRM_PORT=8090
CRM_BASE_PATH=/crm
# Optional presentation value; it never changes CORS or binding.
CRM_PUBLIC_ORIGIN=https://crm-chat.example.internal
# Exact Salesforce Lightning origins allowed by CORS. Comma-separated, no wildcard.
CRM_ALLOWED_ORIGINS=https://runnergroup--uat.sandbox.my.sfcrmproducts.cn
# Set true only when a trusted reverse proxy overwrites X-Forwarded-For.
CRM_TRUST_PROXY=false

# OpenClaw CRM channel plugin ingress (loopback is preferred).
CRM_OPENCLAW_URL=http://127.0.0.1:18789/plugins/sfoa-crm
# >=32 random non-whitespace characters; must equal the plugin's serviceToken.
CRM_OPENCLAW_SERVICE_TOKEN=
# Server-side Gateway credential used ONLY by the CRM history route
# (auth:"gateway" + trusted-operator). Prefer a dedicated read-only device
# token; the shared Gateway token is a documented fallback. Never a user identity.
CRM_GATEWAY_HISTORY_TOKEN=

# Pinned Apex signing certificate (public certificate PEM or bare public key PEM).
CRM_APEX_PUBLIC_KEY_PATH=config/crm/apex-signing-cert.pem
# Optional SHA-256 of the certificate DER (recommended when a certificate is used).
CRM_APEX_CERT_SHA256=
CRM_APEX_ISSUER=sfoa-crm-apex
CRM_APEX_AUDIENCE=sfoa-crm-gateway
# Comma-separated 15/18-character Salesforce org ids.
CRM_APEX_ALLOWED_ORG_IDS=<15-or-18-character-salesforce-org-id>
CRM_APEX_MAX_AGE_MS=120000
CRM_APEX_MAX_TTL_MS=120000
CRM_APEX_CLOCK_SKEW_MS=30000

# Browser chat credential lifetime (5-60 minutes). Salesforce logout does not revoke it instantly.
CRM_CHAT_TOKEN_TTL_MS=900000
CRM_BOOTSTRAP_NONCE_RETENTION_MS=600000
CRM_MAX_BODY_BYTES=65536
CRM_REQUEST_TIMEOUT_MS=660000
CRM_MAX_MESSAGE_CHARS=16000
CRM_HISTORY_LIMIT_MAX=100
CRM_CONVERSATION_LIST_LIMIT=50
CRM_RUN_STALE_AFTER_MS=900000
CRM_CLEANUP_INTERVAL_MS=300000

# Optional direct TLS. Leave both empty when TLS terminates at nginx.
CRM_TLS_KEY_PATH=
CRM_TLS_CERT_PATH=
