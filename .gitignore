# -- CLEAN

# use yarn by default, so ignore npm
package-lock.json

# never check in npm config
.npmrc

# debug logs
npm-error.log
yarn-error.log
lerna-debug.log

# compile source
lib

dist

# test artifacts
*xunit.xml
*checkstyle.xml
*unitcoverage
.nyc_output
coverage
/packages/sfoa-admin-web/playwright-report/
/packages/sfoa-admin-web/test-results/

# generated docs, except authoritative SFoA and Agent distribution docs
docs/*
!docs/sfoa/
!docs/sfoa/**
!docs/agent/
!docs/agent/**


npm-shrinkwrap.json
oclif.manifest.json
oclif.lock

# -- CLEAN ALL
node_modules


.eslintcache
.wireit
*.tsbuildinfo

# --
# put files here you don't want cleaned with sf-clean

.sfdx

# os specific files
.DS_Store
.idea
/Library

.cursor
tmp
.temp/

# local agent/web research cache
.firecrawl/

# local environment and credentials
.env.local
.env.*.local
*.key
*.pem
secrets/
.workbuddy/*
